{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Pytest with nohup (Detached)",
            "type": "shell",
            "command": "${workspaceFolder}/run_tests_nohup.sh",
            "args": [
                "--config-path=/home/student/2025-bsc-kuppler-flowmeter/flowtest-configs",
                "--replicator=kuppler-2-dpdk",
                "--collector=ipfixcol-1:protocol=tcp",
                "--probe=yaf-pfring-pcap-4",
                "--disable-ansible",
                "--html=logs/report.html",
                "--self-contained-html",
                "--continue-on-collection-errors",
                "--capture=tee-sys",
                "-m",
                "simulation and cbr and 100G and 1MA"
            ],
            "problemMatcher": []
        },
        {
            "label": "Run Pytest for all probes with nohup (Detached)",
            "type": "shell",
            "command": "${workspaceFolder}/run_all_tests_nohup.sh",
            "args": [],
            "problemMatcher": []
        }
    ]
}